# Всё, что здесь есть, задаётся и в админке — она пишет то же самое в базу и
# имеет приоритет над этим файлом. Здесь удобно поднять бота с нуля.
# Открыть админку: /admin в боте.

# Единственное, что нужно для первого запуска. Если пусто — окно админки
# откроется само и попросит токен.
TG_TOKEN=

# Остальные ключи вводятся в админке; здесь — только чтобы поднять без неё.
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=

# Панель слушает 127.0.0.1. Порт меняется, если 8770 занят.
PANEL_PORT=8770
